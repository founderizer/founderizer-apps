<Project Sdk="Microsoft.NET.Sdk">
  <!-- The logic of Founderizer for Windows, with no Windows call: it builds and tests on macOS, Linux and Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Founderizer.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one package that is not in the box: X25519, Ed25519 and ChaCha20-Poly1305 (windows-app-plan.md, 4). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Founderizer.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The marks' outlines as FleetMark draws them (Tests/FleetMarkTests/MarkVectorsTests.swift writes the file). -->
    <EmbeddedResource Include="../../vectors/agent-marks.json" LogicalName="agent-marks.json" />
  </ItemGroup>
</Project>
