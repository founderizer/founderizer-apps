<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of the screens' own parts that call no WinUI: the sample fleet as the store's state, read by the
       library's models, and the window's history. They need no window; the plan runs them on Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Founderizer.Windows.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
    <PackageReference Include="MSTest.TestAdapter" Version="[4.5.1]" />
    <PackageReference Include="MSTest.TestFramework" Version="[4.5.1]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Founderizer.Core/Founderizer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Founderizer.Windows/Fleet/IFleetSource.cs" Link="Linked/IFleetSource.cs" />
    <Compile Include="../Founderizer.Windows/Fleet/SampleSource.cs" Link="Linked/SampleSource.cs" />
    <Compile Include="../Founderizer.Windows/Navigation/History.cs" Link="Linked/History.cs" />
    <EmbeddedResource Include="../Founderizer.Windows/Sample/SampleFleet.json" LogicalName="Founderizer.Windows.Sample.SampleFleet.json" />
  </ItemGroup>
</Project>
