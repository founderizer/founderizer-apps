<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests, the shared vectors of app/vectors, and the decode twin (FLEET_E2E_HUB). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Founderizer.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
    <PackageReference Include="MSTest.TestAdapter" Version="[4.5.1]" />
    <PackageReference Include="MSTest.TestFramework" Version="[4.5.1]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Founderizer.Core/Founderizer.Core.csproj" />
    <!-- The decode twin of the owner's reads of each page family (windows-app-plan-v2.md, section 6), which app_decode.py
         runs from this project: Founderizer.Owner names Founderizer.Core alone. -->
    <ProjectReference Include="../Founderizer.Owner/Founderizer.Owner.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../vectors/*.json" Link="vectors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The credit of FleetCore, which CreditTests holds the library's credit equal to. -->
    <None Include="../../Sources/FleetCore/Credit.swift" Link="sources/Credit.swift" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Swift views whose words the library gives the screens (SwiftWordsTests): their literals are the words. -->
    <None Include="../../Sources/Founderizer/NeedRequestCard.swift;../../Sources/Founderizer/AttachmentViews.swift;../../Sources/Founderizer/FleetView.swift;../../Sources/Founderizer/AgentStatusPanel.swift;../../Sources/Founderizer/ThreadViews.swift" Link="sources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../ios/Sources/AgentPage.swift;../../ios/Sources/ChatPage.swift" Link="sources/ios/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
