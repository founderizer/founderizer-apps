<?xml version="1.0" encoding="utf-8"?>
<!-- The one package source of Founderizer for Windows: nuget.org, and no source of this machine's own setup. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
