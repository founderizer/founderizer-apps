<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of Founderizer.Setup, which run on this Mac as those of Founderizer.Core do; the vectors of app/vectors
       beside them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Founderizer.Setup.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
    <PackageReference Include="MSTest.TestAdapter" Version="[4.5.1]" />
    <PackageReference Include="MSTest.TestFramework" Version="[4.5.1]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Founderizer.Setup/Founderizer.Setup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../vectors/*.json" Link="vectors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Mac's string catalog, which holds the words that the PC's first run copies from the Mac's view files. -->
    <None Include="../../Localization/Localizable.xcstrings" Link="catalog/Localizable.xcstrings" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
