<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The opener of a sealed ping (UI-API.md 1.76). Xcode writes the bundle's own keys; this file adds only the
     extension point: iOS runs it for every ping that says "mutable-content", before the banner shows. -->
<plist version="1.0"><dict>
<key>NSExtension</key><dict>
<key>NSExtensionPointIdentifier</key><string>com.apple.usernotifications.service</string>
<key>NSExtensionPrincipalClass</key><string>$(PRODUCT_MODULE_NAME).NotificationService</string>
</dict>
</dict></plist>
