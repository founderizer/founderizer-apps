<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The installer is not sandboxed: it runs the hub's own join line on that Mac, which installs this fleet's
     machine with Homebrew, git, tmux and Python, and then runs `fleet.py verify`. It listens on one port of the
     local network and reaches nothing else of its own accord. -->
<plist version="1.0"><dict>
<key>com.apple.security.app-sandbox</key><false/>
<key>com.apple.security.network.server</key><true/>
<key>com.apple.security.network.client</key><true/>
</dict></plist>
