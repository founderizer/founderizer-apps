          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID de la app y ese archivo, abajo."
          }
        }
      }
    },
    "The App ID and the private key are in the two rows below: a save takes the place of the file that is there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
