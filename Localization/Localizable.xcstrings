          }
        }
      }
    },
    "The central vault does not answer with the key this Mac pinned. Nothing was sent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda central no responde con la clave que fijó este Mac. No se envió nada."
          }
        }
