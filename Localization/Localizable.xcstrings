    },
    "That file is empty." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo está vacío."
          }
        }
      }
    },
    "That file is not a copy of a fleet. Choose the zip your hub gave you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo no es una copia de una flota. Elige el zip que te dio tu hub."
          }
        }
      }
    },
    "That is longer than we take. Keep it under %@ characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es más largo de lo que aceptamos. Mantenlo por debajo de %@ caracteres."
