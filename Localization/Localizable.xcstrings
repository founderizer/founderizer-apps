    "That is too long: at most 200 characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado largo: 200 caracteres como máximo."
          }
        }
      }
    },
    "That key belongs to App %@, not to the App ID you gave." : {
      "localizations" : {
