      }
    },
    "That file did not open." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo no se abrió."
          }
        }
      }
    },
    "That file holds no RSA private key that this Mac can read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo no contiene ninguna clave privada RSA que este Mac pueda leer."
          }
