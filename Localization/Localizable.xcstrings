    },
    "That copy is format %lld and this app reads format %lld." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa copia tiene el formato %lld y esta app lee el formato %lld."
          }
        }
      }
    },
    "That download is not signed by Tailscale, so this Mac did not open it. Nothing was installed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa descarga no está firmada por Tailscale, así que este Mac no la abrió. No se instaló nada."
