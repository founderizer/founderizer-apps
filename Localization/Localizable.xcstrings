        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las herramientas del agente"
          }
        }
      }
    },
    "The agents of this server run as %@, so the fleet can reach it as root or as %@. Another user would leave the server on record as one Founderizer may not use." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes de este servidor se ejecutan como %@, así que la flota puede llegar a él como root o como %@. Con otro usuario, el servidor quedaría registrado con uno que Founderizer no puede usar."
          }
        }
      }
    },
    "The answer was not accepted. Check the setup connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La respuesta no se aceptó. Comprueba la conexión de la configuración."
          }
        }
      }
    },
    "The application in the download carries no code signature this Mac can read." : {
      "localizations" : {
        "es" : {
