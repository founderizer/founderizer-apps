      }
    },
    "The application in the download does not say which version it is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación de la descarga no dice qué versión es."
          }
        }
      }
    },
    "The application in the download is not signed by whoever signed the Founderizer you are running (%lld). Nothing was installed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación de la descarga no está firmada por quien firmó el Founderizer que usas (%lld). No se instaló nada."
          }
        }
      }
    },
    "The authenticator seed can have only the letters A to Z and the digits 2 to 7, or be an otpauth:// address with such a secret." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
