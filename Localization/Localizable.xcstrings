      }
    },
    "This server has %@ of memory, and a server for agents needs about %@. Choose a plan with more memory." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor tiene %@ de memoria, y un servidor para agentes necesita unos %@. Elige un plan con más memoria."
